# #208 — Imagem de PRODUÇÃO do frontend: build estático do React servido por nginx.
# (O `Dockerfile` ao lado é o de desenvolvimento: `npm start` com hot-reload.)
#
#   docker build -f Dockerfile.prod -t sgi-frontend .
#
# O nginx serve a SPA e faz proxy de /api para o backend (mesma origem: sem CORS
# e sem URL da API embebido no build). Ver nginx.conf e docs/producao-frontend.md.

# ── 1. Build ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
# Vazio = a API é chamada na mesma origem (/api), através do proxy do nginx.
ARG REACT_APP_API_URL=""
ENV REACT_APP_API_URL=$REACT_APP_API_URL \
    GENERATE_SOURCEMAP=false \
    CI=true
RUN npm run build

# ── 2. Runtime ──────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q --spider http://127.0.0.1/ || exit 1
