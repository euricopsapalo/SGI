# ─────────────────────────────────────────────────────────────
# SGI — Exemplo de variáveis de ambiente
# Copiar para `.env` e preencher. NUNCA committar o `.env` real.
#
# Em produção, definir estas variáveis através do orquestrador
# (Docker secrets, AWS Secrets Manager, Kubernetes Secret, etc.)
# em vez de um ficheiro .env.
# ─────────────────────────────────────────────────────────────

# ── Base de dados (PostgreSQL) ──
DB_HOST=postgres
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_development

# ── Backend ──
PORT=3001
# ── Ambiente: development | staging | production ──
# NODE_ENV=production desativa Swagger (/api/docs) e o rate-limit em testes.
NODE_ENV=development

# ── Admin inicial em produção (issue #197) ──
# Fora de produção o seed cria os utilizadores de demonstração (admin/tecnico/vendas).
# Em produção NÃO cria utilizadores com passwords conhecidas: só cria um admin
# inicial se não existir nenhum admin e esta password estiver definida (ou o
# ficheiro SEED_ADMIN_PASSWORD_FILE, via Docker secret). Nunca reescreve passwords.
# SEED_ADMIN_EMAIL=admin@aquatex.ao
# SEED_ADMIN_PASSWORD=

# ── Segurança (issue #24) ──
# OBRIGATÓRIO. Segredo de assinatura dos JWT — mínimo 32 caracteres.
# A aplicação FALHA o arranque se ausente ou demasiado curto.
# Gerar um forte, ex.: `openssl rand -hex 32`.
JWT_SECRET=troca-me-por-um-segredo-forte-de-32-ou-mais-chars

# ── CORS (issue #23) ──
# Lista de origens permitidas, separadas por vírgula. Em produção,
# restringir ao domínio oficial (ex.: https://sgi.aquatex.ao).
CORS_ORIGIN=http://localhost:3000

# ── SMTP (recuperação de password) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
