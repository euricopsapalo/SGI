{
  "name": "backend",
  "version": "1.0.0",
  "description": "NestJS Backend",
  "scripts": {
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --runInBand --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.config.js --runInBand",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate src/migrations/Migration",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:show"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "modules/auth/auth.service.ts",
      "modules/ordens-trabalho/ordens-trabalho.service.ts",
      "modules/encomendas/encomendas.service.ts",
      "modules/faturas/faturas.service.ts",
      "modules/artigos/artigos.service.ts",
      "modules/configuracao/configuracao.service.ts",
      "modules/vendas-config/matriz.rules.ts",
      "modules/vendas-config/series.rules.ts",
      "modules/vendas-config/documentos-config.service.ts",
      "modules/vendas-config/series.service.ts",
      "modules/vendas/vendas.rules.ts",
      "modules/vendas/documentos-venda.service.ts",
      "modules/tesouraria/tesouraria.rules.ts",
      "modules/tesouraria/liquidacoes.service.ts",
      "modules/tesouraria/conta-corrente.service.ts",
      "modules/vendas/impressao-fatura.service.ts",
      "modules/tesouraria/impressao-recibo.service.ts",
      "modules/clientes/clientes.service.ts",
      "modules/tecnicos/tecnicos.service.ts",
      "modules/parque/parque.service.ts",
      "modules/planos/planos.service.ts",
      "modules/fornecedores/fornecedores.service.ts",
      "modules/faturas-fornecedor/faturas-fornecedor.service.ts",
      "modules/tabelas-sistema/tabelas-sistema.service.ts",
      "modules/users/users.service.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 60,
        "lines": 60,
        "branches": 45,
        "functions": 60
      },
      "**/modules/auth/auth.service.ts": {
        "statements": 80,
        "lines": 80
      },
      "**/modules/artigos/artigos.service.ts": {
        "statements": 80,
        "lines": 80
      },
      "**/modules/encomendas/encomendas.service.ts": {
        "statements": 80,
        "lines": 80
      },
      "**/modules/faturas/faturas.service.ts": {
        "statements": 80,
        "lines": 80
      },
      "**/modules/configuracao/configuracao.service.ts": {
        "statements": 80,
        "lines": 80
      },
      "**/modules/vendas-config/*.rules.ts": {
        "statements": 90,
        "lines": 90
      },
      "**/modules/vendas-config/*.service.ts": {
        "statements": 80,
        "lines": 80
      },
      "**/modules/vendas/vendas.rules.ts": {
        "statements": 90,
        "lines": 90
      },
      "**/modules/vendas/impressao-fatura.service.ts": {
        "statements": 80,
        "lines": 80
      },
      "**/modules/vendas/documentos-venda.service.ts": {
        "statements": 80,
        "lines": 80
      },
      "**/modules/tesouraria/tesouraria.rules.ts": {
        "statements": 90,
        "lines": 90
      },
      "**/modules/tesouraria/*.service.ts": {
        "statements": 80,
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^6.4.23",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "helmet": "^7.2.0",
    "joi": "^17.13.4",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.3",
    "puppeteer-core": "24.43.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.30",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "1.1.5",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^30.3.0",
    "pdf-parse": "1.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0"
  }
}
